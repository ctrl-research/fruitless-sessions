#!/usr/bin/env bash
# Push the bundled takes to the data-only `gh-pages` branch as a single orphan commit, so the
# branch never accumulates history (bundles are ~100 MB each). The Pages workflow then builds
# the stage from `main` and deploys it with these takes; merging to `main` redeploys the same
# way, so this script is only needed when the takes change.
#
#   scripts/publish
#
# Simulation runs only on Apple silicon, so this is a local step: the takes under
# stage/public/takes are whatever `fruitless take`, `bundle` and `meshes` produced here.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TAKES="$ROOT/stage/public/takes"
[ -f "$TAKES/index.json" ] || { echo "no takes bundled: run fruitless bundle first" >&2; exit 2; }
SIZE=$(du -sh "$TAKES" | cut -f1)
TMP="$(mktemp -d)"
git -C "$ROOT" worktree add --detach "$TMP"
( cd "$TMP"
  # a throwaway orphan branch; pushed to gh-pages by ref so a stale local gh-pages never blocks it
  git checkout --orphan "publish-$$"
  git rm -rfq . >/dev/null 2>&1 || true
  mkdir takes
  cp -R "$TAKES/." takes/
  # a push-triggered workflow only runs if it exists on the pushed branch
  mkdir -p .github/workflows
  cp "$ROOT/.github/workflows/pages.yml" .github/workflows/pages.yml
  git add -A
  git -c user.name="fruitless publish" -c user.email="noreply@ctrl-research" commit -qm "takes $(date -u +%Y-%m-%dT%H:%MZ) from $(git -C "$ROOT" rev-parse --short HEAD)"
  git push -f origin "HEAD:gh-pages"
)
git -C "$ROOT" worktree remove --force "$TMP"
git -C "$ROOT" branch -D "publish-$$" >/dev/null 2>&1 || true
git -C "$ROOT" branch -D gh-pages >/dev/null 2>&1 || true
echo "pushed takes to gh-pages ($SIZE); the Pages workflow builds main and deploys: gh run list --workflow pages.yml"
